# Backend address. Android emulator + local backend: http://10.0.2.2:8000
# Real phone on same Wi-Fi: http://<your PC's IP>:8000   (ipconfig ile bulabilirsin)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Only if the backend has SENSEA_APP_KEY set
EXPO_PUBLIC_APP_KEY=
# RevenueCat public SDK keys (Project settings > API keys). Purchases need a development/store build.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# DEVELOPMENT ONLY: test Premium features before store products exist (free | premium | plus).
# Backend must run with SENSEA_DEV_TIERS=1. Never ship a build with this set.
EXPO_PUBLIC_DEV_TIER=
# Crash reports (sentry.io > Project > Client Keys). Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
