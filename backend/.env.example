# --- AI ---------------------------------------------------------------------------
# Claude: emotion reading, outfits, wardrobe photo tagging. Without it the rule-based engine runs.
ANTHROPIC_API_KEY=
SENSEA_MODEL=claude-haiku-5-5
# fal.ai: realistic outfit images (Premium). Without it a labelled demo image is returned.
FAL_KEY=
SENSEA_IMAGE_MODEL=fal-ai/flux-2-pro
SENSEA_IMAGE_EDIT_MODEL=fal-ai/flux-2-pro/edit

# --- Subscriptions ----------------------------------------------------------------
# RevenueCat secret API key (v1). Used to check the "premium" / "plus" entitlements.
REVENUECAT_SECRET_KEY=
# DEVELOPMENT ONLY: trust the X-Dev-Tier header. Never enable in production.
SENSEA_DEV_TIERS=0

# --- Limits -----------------------------------------------------------------------
SENSEA_FREE_DAILY=5          # free outfits per day
SENSEA_PREMIUM_RENDERS=30    # AI images per month
SENSEA_PLUS_RENDERS=100
SENSEA_PLUS_TAGS=400         # wardrobe photos tagged per month
SENSEA_FREE_SWAPS=15         # "swap this piece" taps per day on the free tier
# SENSEA_BG_MODEL=fal-ai/birefnet/v2   # background removal for wardrobe photos (uses FAL_KEY)
SENSEA_DB=sensea_usage.db    # SQLite usage counters; put it on a persistent disk
SENSEA_RATE_LIMIT=30         # burst limit: requests per window per device
SENSEA_RATE_WINDOW=600

# --- Misc -------------------------------------------------------------------------
SENSEA_APP_KEY=              # if set, the app must send it as X-Sensea-Key
SENSEA_CORS=*
SENSEA_CONTACT_EMAIL=        # shown on /privacy (store listings need a privacy policy URL)
SENSEA_ADMIN_KEY=            # protects GET /v1/stats (anonymous daily event counts)
